#!/bin/sh
# Only copy trusted network time to RTC; never use an unsynchronised boot clock.
case "$ACTION" in stratum|step) ;; *) exit 0 ;; esac
case "$stratum" in ''|*[!0-9]*) exit 0 ;; esac
[ "$stratum" -gt 0 ] && [ "$stratum" -lt 16 ] || exit 0
if timeout 5 /sbin/hwclock -w -u && timeout 5 /sbin/hwclock -r >/dev/null 2>&1; then
    logger -t mira-rtc 'RTC updated from synchronised network time'
else
    logger -t mira-rtc 'RTC write failed; check backup supply/battery'
fi
